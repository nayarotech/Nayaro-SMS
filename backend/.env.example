NODE_ENV=development
PORT=4000
# Public base URL of this API (used to build file links)
PUBLIC_API_URL=http://localhost:4000
# School websites: /sites/<CODE> always works. Set this to also serve <code>.<domain> (needs wildcard DNS).
SITES_BASE_DOMAIN=
# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# root is used in development because `prisma migrate dev` needs to create a shadow database
DATABASE_URL=mysql://root:root@localhost:3306/sms
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Used to hash OTP codes before storing them in Redis
OTP_SECRET=change-me-otp-secret-at-least-32-characters

# File storage: "local" for now (files saved under STORAGE_LOCAL_DIR). An "s3" driver can be added later.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Max upload size in megabytes
UPLOAD_MAX_MB=10

# Chrome or Chromium for PDFs (report cards, receipts). Leave empty to find it automatically.
PDF_CHROME_PATH=

# SMS provider for OTPs: "console" (prints to the server log) or "sparrow" (Sparrow SMS, Nepal)
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Created by `npm run db:seed`
SEED_SUPER_ADMIN_EMAIL=superadmin@sms.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
